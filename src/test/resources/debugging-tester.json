{
	"options": {
		"database": "mysql",
		"generators": [
			"java",
			"sql"
		]
	},
	"database": {
		"schema": "library",
		"package": "synapticloop.library.database.mysql.library",
		"tables": [
			{
				"name": "agency_agreement",
				"charset": "utf8mb4",
				"fields": [
					{ "name": "id_agency_agreement", "type": "bigint", "primary": true, "nullable": false },

					{ "name": "num_strata_plan", "type": "int", "nullable": false, "unique": true },
					{ "name": "dt_agency_agreement_start", "type": "date", "nullable": false },
					{ "name": "dt_agency_agreement_end", "type": "date", "nullable": false },
					{ "name": "flt_percent_increase", "type": "float", "length": "6", "decimalLength": 1, "nullable": true },
					{ "name": "txt_notes", "type": "varchar", "length": "256", "nullable": true },
					{ "name": "fl_is_current", "type": "boolean", "nullable": false, "default": "'1'" }
				],
				"findAllOrdered": [
					"num_strata_plan desc,dt_agency_agreement asc",
					"dt_agency_agreement asc"
				],
				"fieldFinders": [
					{ "fields":  "num_strata_plan,fl_is_current", "orderBy":  "num_strata_plan asc", "unique": false },
					{ "fields":  "num_strata_plan,fl_is_current", "orderBy":  "num_strata_plan asc,fl_is_current desc", "unique": false },
					{ "fields":  "notNull:num_strata_plan,null:fl_is_current", "orderBy":  "num_strata_plan asc,fl_is_current desc", "unique": false },
					{ "num_strata_plan": "multiple" }
				],
				"fieldNullFinders": [
					{ "txt_notes":  "multiple" }
				],
				"fieldNotNullFinders": [
					{ "txt_notes":  "multiple" }
				],
				"finders": [
					{
						"name": "findAllOrdered",
						"whereClause": [
							"where 1=1",
							"order by num_strata_plan asc, dt_agency_agreement desc"
						]
					},
					{
						"name": "findRolloversByMonth",
						"whereClause": [
							"month(current()) = month(?)",
							"order by num_strata_plan asc"
						],
						"whereFields": [
							{ "name":  "dt_agency_agreement_start", "isHidden": true, "alias": "dtAgencyAgreementStart" }
						]
					}
				]
			}
		]
	}
}