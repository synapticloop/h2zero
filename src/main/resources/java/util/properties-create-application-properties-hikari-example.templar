#{\n}
#    (/java/util/properties-create-application-properties-example.templar){\n}
# {\n}
# This is an example .properties file which can be used (or ignored) as a quick{\n}
# properties file for connecting to a specific database using the hikari {\n}
# connection pooling mechanism.{\n}
#
# This also is used by the default file that is generated for the example {\n}
# connection manager, which is located:{\n}
#{\n}
#     {database.package}.ConnectionManagerInitialiser{\n}
#{\n}
#     {database.package}.ConnectionManagerInitialiserOverride{\n}
#{\n}
#{\n}
# # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # #{\n}
{\n}
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -{\n}
# {\n}
# The following properties are required when no database exists and a new one {\n}
# is being created.  The username and password may be different as they will {\n}
# need to have permissions to create the database.{\n}
# {\n}
# You cannot connect to a jdbc url with a database appended to it, so it is a{\n}
# blank jdbc url{\n}
# {\n}
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -{\n}
{\n}
dataSource.initial.user=root{\n}
dataSource.initial.password=password{\n}
dataSource.initial.url={options.initialJdbcUrl}{\n}
{\n}
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -{\n}
# {\n}
# The following properties are used by the hikari database connection pool{\n}
# {\n}
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -{\n}
{\n}
username=root{\n}
password=password{\n}
jdbcUrl={options.jdbcUrl}{\n}
maximumPoolSize={options.maxPoolSize}{\n}
minimumIdle={options.minPoolSize}{\n}
connectionTimeout=30000{\n}
idleTimeout=600000{\n}
leakDetectionThreshold=2000{\n}
{\n}